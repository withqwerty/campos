{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campos.football/schema/phase-map-snapshot.schema.json",
  "title": "PhaseMapSnapshot",
  "description": "A reusable score-space visual packet for output/cost quadrant maps. It carries points, team centroids, evidence, caveats, and calibration status, but not match-specific scoring logic.",
  "type": "object",
  "required": [
    "id",
    "matchId",
    "coordinateFrame",
    "xAxis",
    "yAxis",
    "calibrationStatus",
    "points",
    "centroids",
    "provider",
    "caveat"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "matchId": {
      "type": "string"
    },
    "coordinateFrame": {
      "const": "diagnostic-score-space",
      "description": "x and y are 0-100 diagnostic score co-ordinates, not pitch co-ordinates."
    },
    "xAxis": {
      "type": "object",
      "required": ["key", "label", "domain"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "domain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "yAxis": {
      "type": "object",
      "required": ["key", "label", "domain"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "domain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "calibrationStatus": {
      "type": "string",
      "enum": [
        "within-match",
        "insufficient-rich-sample",
        "multi-match-baseline-ready",
        "unknown"
      ]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phaseId",
          "side",
          "teamName",
          "label",
          "phaseType",
          "period",
          "startMinute",
          "startSecond",
          "endMinute",
          "endSecond",
          "x",
          "y",
          "outputScore",
          "costScore",
          "repeatabilityScore",
          "repeatabilityLabel",
          "quadrant",
          "evidence",
          "caveat"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "phaseId": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": ["home", "away"]
          },
          "teamName": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "phaseType": {
            "type": "string"
          },
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "startMinute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "startSecond": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          },
          "endMinute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "endSecond": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "outputScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "costScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "repeatabilityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "repeatabilityLabel": {
            "type": "string",
            "enum": ["stable", "mixed", "fragile"]
          },
          "quadrant": {
            "type": "string",
            "enum": [
              "high-output-high-cost",
              "high-output-low-cost",
              "low-output-high-cost",
              "low-output-low-cost"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caveat": {
            "type": "string"
          },
          "sourceMeta": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "centroids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "side",
          "teamName",
          "x",
          "y",
          "outputScore",
          "costScore",
          "count",
          "evidence",
          "caveat"
        ],
        "additionalProperties": false,
        "properties": {
          "side": {
            "type": "string",
            "enum": ["home", "away"]
          },
          "teamName": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "outputScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "costScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caveat": {
            "type": "string"
          },
          "sourceMeta": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "provider": {
      "type": "string"
    },
    "caveat": {
      "type": ["string", "null"],
      "description": "Calibration or interpretation caveat. Null only when no caveat is needed."
    },
    "sourceMeta": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Provider-scoped metadata bag for provenance and debugging."
    }
  }
}
