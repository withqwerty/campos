{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campos.football/schema/player-surface-snapshot.schema.json",
  "title": "PlayerSurfaceSnapshot",
  "description": "A reusable player-level visual packet for lineup, average-position, passing-network, and role-tag views. It carries derived geometry, evidence, and caveats, but not match-specific tactical conclusions.",
  "type": "object",
  "required": [
    "id",
    "matchId",
    "coordinateFrame",
    "primaryWindow",
    "lineups",
    "averagePositions",
    "passingNetworkEdges",
    "roleTags",
    "provider"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "matchId": {
      "type": "string"
    },
    "coordinateFrame": {
      "const": "absolute-pitch",
      "description": "All x/y values are Campos absolute full-pitch co-ordinates."
    },
    "primaryWindow": {
      "type": "object",
      "required": [
        "label",
        "startMinute",
        "startSecond",
        "endMinute",
        "endSecond",
        "evidence",
        "caveat"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "startMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "startSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "endMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "endSecond": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveat": {
          "type": "string"
        }
      }
    },
    "lineups": {
      "oneOf": [{ "$ref": "./match-lineups.schema.json" }, { "type": "null" }],
      "description": "Home and away team sheets used by the player-level view, when available."
    },
    "averagePositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "side",
          "playerId",
          "playerName",
          "x",
          "y",
          "eventCount",
          "passCount",
          "windowLabel",
          "evidence",
          "caveat"
        ],
        "additionalProperties": false,
        "properties": {
          "side": {
            "type": "string",
            "enum": ["home", "away"]
          },
          "playerId": {
            "type": "string"
          },
          "optaId": {
            "type": ["string", "null"]
          },
          "playerName": {
            "type": "string"
          },
          "shirtNumber": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "position": {
            "type": ["string", "null"]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "eventCount": {
            "type": "integer",
            "minimum": 0
          },
          "passCount": {
            "type": "integer",
            "minimum": 0
          },
          "windowLabel": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caveat": {
            "type": "string"
          },
          "sourceMeta": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "passingNetworkEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "side",
          "fromPlayerId",
          "toPlayerId",
          "fromPlayerName",
          "toPlayerName",
          "x",
          "y",
          "endX",
          "endY",
          "count",
          "inferred",
          "evidence",
          "caveat"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": ["home", "away"]
          },
          "fromPlayerId": {
            "type": "string"
          },
          "fromOptaId": {
            "type": ["string", "null"]
          },
          "fromShirtNumber": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "fromPlayerName": {
            "type": "string"
          },
          "toPlayerId": {
            "type": "string"
          },
          "toOptaId": {
            "type": ["string", "null"]
          },
          "toShirtNumber": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "toPlayerName": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "endX": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "endY": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "inferred": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caveat": {
            "type": "string"
          },
          "sourceMeta": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "roleTags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "side",
          "playerId",
          "playerName",
          "label",
          "score",
          "evidence",
          "caveat"
        ],
        "additionalProperties": false,
        "properties": {
          "side": {
            "type": "string",
            "enum": ["home", "away"]
          },
          "playerId": {
            "type": "string"
          },
          "optaId": {
            "type": ["string", "null"]
          },
          "playerName": {
            "type": "string"
          },
          "shirtNumber": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "position": {
            "type": ["string", "null"]
          },
          "label": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caveat": {
            "type": "string"
          },
          "sourceMeta": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "provider": {
      "type": "string"
    },
    "caveat": {
      "type": ["string", "null"],
      "description": "Missingness or interpretation caveat. Null only when no caveat is needed."
    },
    "sourceMeta": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  }
}
